# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native — android/ is generated by prebuild on EAS and never committed.
/android

# ios/ IS committed, as a bare project. Regenerate it with
#   npx expo prebuild --platform ios --clean --no-install
# after changing any iOS-affecting app.json field — see CLAUDE.md. Its own
# ios/.gitignore covers Pods/, build/ and .xcode.env.local. The one file that
# needs rescuing is .xcode.env, which is meant to be versioned (it sources
# NODE_BINARY for Xcode script phases) but matches `*.env` in the repo-root
# .gitignore.
!/ios/.xcode.env
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*
.metro-cache/


# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example
