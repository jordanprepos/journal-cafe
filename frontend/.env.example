# Café Journal — Firebase client config.
# Copy to frontend/.env and fill in. Every value here is a public client
# identifier, not a secret: access is enforced by firestore.rules / storage.rules.
#
# Expo bakes EXPO_PUBLIC_* into the bundle at startup — restart Metro after editing.
#
# Fetch the web app values with:
#   npx -y firebase-tools@latest apps:sdkconfig WEB --project <PROJECT_ID>

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-in OAuth clients. Firebase generates these when Google sign-in is
# enabled; find them in Google Cloud Console > APIs & Services > Credentials.
#
# WEB is required on every platform: Firebase's popup uses it on web, and on
# Android it is the audience of the ID token the native SDK returns. IOS is
# needed for the iOS URL scheme.
#
# There is deliberately no ANDROID entry. Google identifies an Android caller by
# package name plus the APK's signing SHA-1, registered against the Firebase
# Android app — so that OAuth client must exist, but its ID is never read by the
# app. See RUNNING.md step 3b.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
