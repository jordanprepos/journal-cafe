rules_version = '2';

// Café photos, one folder per café: users/{uid}/cafes/{cafeId}/{file}.
// Written by frontend/src/api/client.ts (uploadPhotos) and read back through
// the download URL embedded in the café's Firestore document.

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/cafes/{cafeId}/{photo} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
