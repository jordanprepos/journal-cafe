rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{uid}/cafes
// Document ID: auto-generated
// Ownership:  implied by the path — {uid} is the owner's Firebase Auth uid.
//
// Fields (mirrors CafeInput in frontend/src/api/client.ts):
//   name              string, non-empty, <= 200 chars      (required)
//   created_at        timestamp, server-generated          (required)
//   photos            list of Cloud Storage download URLs  (required)
//   location_link     string                               (required)
//   address           string                               (required)
//   notes             string                               (required)
//   rating            int, 0..5                            (required)
//   favorite_drink    string                               (required)
//   visited_date      string, ISO date                     (required)
//   tags              list, <= 20 entries                  (required)
//   latitude          number -90..90, or null              (optional)
//   longitude         number -180..180, or null            (optional)
//   price_min         number >= 0, or null                 (optional)
//   price_max         number >= 0, or null                 (optional)
//   price_currency    string, 3-letter ISO 4217, or null   (optional)
//   recommended_menu  list                                 (optional)
//   facilities        list                                 (optional)
//   hospitality       int, 0..5                            (optional)
//
// Queries these rules must permit:
//   collection(users/{uid}/cafes).orderBy('created_at', 'desc')   — list + onSnapshot
//   doc(users/{uid}/cafes/{cafeId})                               — get + onSnapshot
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function inRange(value, low, high) {
      return value is number && value >= low && value <= high;
    }

    // Optional numeric field: absent, explicitly null, or within range.
    function optionalNumber(data, field, low, high) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || inRange(data[field], low, high);
    }

    function isValidCafe(data) {
      return data.keys().hasAll([
               'name', 'created_at', 'photos', 'location_link', 'address',
               'notes', 'rating', 'favorite_drink', 'visited_date', 'tags'
             ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.created_at is timestamp
        && data.photos is list && data.photos.size() <= 20
        && data.location_link is string
        && data.address is string
        && data.notes is string && data.notes.size() <= 20000
        && data.rating is int && data.rating >= 0 && data.rating <= 5
        && data.favorite_drink is string
        && data.visited_date is string
        && data.tags is list && data.tags.size() <= 20
        && optionalNumber(data, 'latitude', -90, 90)
        && optionalNumber(data, 'longitude', -180, 180)
        && optionalNumber(data, 'price_min', 0, 1000000000)
        && optionalNumber(data, 'price_max', 0, 1000000000)
        && (!data.keys().hasAny(['price_currency'])
            || data.price_currency == null
            || (data.price_currency is string && data.price_currency.matches('^[A-Z]{3}$')))
        && (!data.keys().hasAny(['recommended_menu'])
            || (data.recommended_menu is list && data.recommended_menu.size() <= 50))
        && (!data.keys().hasAny(['facilities'])
            || (data.facilities is list && data.facilities.size() <= 20))
        && (!data.keys().hasAny(['hospitality'])
            || (data.hospitality is int && data.hospitality >= 0 && data.hospitality <= 5));
    }

    match /users/{uid}/cafes/{cafeId} {
      allow get, list: if isOwner(uid);
      allow delete: if isOwner(uid);
      // Validated on create AND update, so a partial update can't leave the
      // document in a shape the app can't read back.
      allow create: if isOwner(uid) && isValidCafe(request.resource.data);
      allow update: if isOwner(uid)
                    && isValidCafe(request.resource.data)
                    // created_at is set once, by the server, and never moves.
                    && request.resource.data.created_at == resource.data.created_at;
    }

    // Default deny — anything not matched above is unreachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
